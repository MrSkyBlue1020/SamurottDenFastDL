// Created by GRIEFYN

"VertexlitGeneric"
{
	"$basetexture" "vgui\replay\thumbnails\models/weapons/c_models/c_pistol/pocket_delivery_01"
	
		 "$phong" "1"
		 "$phongexponent" "9"
		 "$phongboost" "6"	
		 "$lightwarptexture" "models\lightwarps\weapon_lightwarp"
         "$phongfresnelranges"	"[.1 .5 3]"
         "$bumpmap" "vgui\replay\thumbnails\models/weapons/c_models/c_pistol/normal_01"

    "$phongExponentTexture" "vgui\replay\thumbnails\models/weapons/c_models/c_pistol/specular_01"
	
	$phongAlbedoTint 1

//SheenColor
	$phongwarptexture "vgui\replay\thumbnails\models/weapons/c_models/c_pistol/sheen_2"


	"$rimlight" "1"						
	"$rimlightexponent" "1"				
	"$rimlightboost" "7"

//Cubemap stuff
	"$envmap" "env_cubemap"	
	"$envmaptint" "[ .5 .5 .5 ]"

//Jaraterfix?: //sheenfix:
	"$halflambert" "1"

"$glowcolor" "1"


"$tempvar" "0"

	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps/cubemap_sheen001"
	"$sheenmapmask" 		"Effects/AnimatedSheen/animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"$yellow" "0"

	"Proxies"
	{
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	
	
		"WeaponSkin" {
		}
	}
}
