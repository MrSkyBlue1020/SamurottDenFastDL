"VertexlitGeneric"
{
	"$basetexture" "vgui\replay\thumbnails\models/weapons/c_models/c_syringegun/tx_glass"
		
		 "$phong" "1"
		 "$phongexponent" "4"
		 "$phongboost" "5"	
	     "$lightwarptexture" "models\lightwarps\weapon_lightwarp"
         "$phongfresnelranges"	"[.25 .5 1]"
         "$envmap" "env_cubemap" // Usa os cubemaps do jogo para reflexo
         "$envmaptint" "[1 1 1]" // Ajusta a intensidade do reflexo (0.0 a 1.0)

	"$phongExponentTexture" "vgui\replay\thumbnails\models/weapons/c_models/c_syringegun/tx_weapon_specular_02"
	$phongAlbedoTint 1

	"$rimlight" "0"
	"$rimlightexponent" "1"	
	"$rimlightboost" "10"


"$tempvar" "0"


	"$blendtintbybasealpha"		"1"
	"$blendtintcoloroverbase"		"0"
	"$rimmask" "1"
	
	"$colortint_tmp"		"[0 0 0]"
	"$bumpmapalphaphongmask"		"1"
	"$cloakPassEnabled"		"1"
	
	"$sheenmap" 		"cubemaps/cubemap_sheen001"
	"$sheenmapmask" 		"Effects/AnimatedSheen/animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

//SheenColor
     $phongwarptexture "vgui\replay\thumbnails\models/weapons/c_models/c_syringegun/sheen_4"

//jaraterfix?:
	"$halflambert" "1"

"$glowcolor" "1"


"$tempvar" "0"

	// Cloaking
	"$cloakPassEnabled" "1"
	"$sheenPassEnabled" "1"

	"$sheenmap" 		"cubemaps/cubemap_sheen001"
	"$sheenmapmask" 		"Effects/AnimatedSheen/animatedsheen0"
	"$sheenmaptint" 		"[ 1 1 1 ]"
	"$sheenmapmaskframe" 	"0"
	"$sheenindex" 		"0"

	"$yellow" "0"

	"Proxies"
	{
		"AnimatedWeaponSheen"
		{
			"animatedtexturevar" 		"$sheenmapmask"
			"animatedtextureframenumvar" 	"$sheenmapmaskframe"
			"animatedtextureframerate" 		"40"
		}
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
		"YellowLevel"
		{
			"resultVar" "$yellow"
		}
		"Multiply"
		{
			"srcVar1" "$color2"
			"srcVar2" "$yellow"
			"resultVar" "$color2"
		}
	
	
		"WeaponSkin" {
		}
	}
}
